<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/ic_launcher_badge"
        android:label="@string/app_name"
        android:theme="@style/Theme.SRMS"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity android:name=".ui.SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RoleSelectActivity" android:exported="false" />
        <activity android:name=".ui.ServerSettingsActivity" android:exported="false" />

        <!-- Student -->
        <activity android:name=".ui.student.StudentLoginActivity" android:exported="false" />
        <activity android:name=".ui.student.StudentRegisterActivity" android:exported="false" />
        <activity android:name=".ui.student.StudentProfileActivity" android:exported="false" />
        <activity android:name=".ui.student.StudentDashboardActivity" android:exported="false" />
        <activity android:name=".ui.student.CourseRegistrationActivity" android:exported="false" />
        <activity android:name=".ui.student.UploadProjectActivity" android:exported="false" />
        <activity android:name=".ui.student.ResultsActivity" android:exported="false" />
        <activity android:name=".ui.student.MaterialsActivity" android:exported="false" />

        <!-- Admin -->
        <activity android:name=".ui.admin.AdminLoginActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminStudentsActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminStudentDetailActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminCoursesActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminRegistrationWindowActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminUploadResultActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminMaterialsActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminProjectsActivity" android:exported="false" />

    </application>
</manifest>
